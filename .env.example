# =====================================================================
# Configuración de APIs — Ingeniería de Soluciones con IA
# Copia este archivo a `.env` y completa las keys.
# Ambos proveedores son GRATIS y NO piden tarjeta de crédito.
# =====================================================================

# --- Chat / LLM: Groq -------------------------------------------------
# API compatible con OpenAI, por eso el código usa el cliente `OpenAI`.
# Obtén tu key en: https://console.groq.com/keys
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_API_KEY=""

# --- Embeddings: Google AI Studio (Gemini) ----------------------------
# Groq NO ofrece endpoint de embeddings, por eso RA1/IL1.3 y RA1/IL1.4
# usan Gemini. Basta la cuenta de Google que ya usas para Colab.
# Obtén tu key en: https://aistudio.google.com/apikey
GOOGLE_API_KEY=""

# --- Observabilidad: LangSmith (opcional, se usa en RA1/IL1.4 y RA3) --
# Obtén tu key en: https://smith.langchain.com/settings
LANGSMITH_TRACING="false"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="ingenieria-soluciones-ia"
