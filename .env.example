# =====================================================================
# Configuración de APIs — Ingeniería de Soluciones con IA
# Copia este archivo a `.env` y completa las keys.
# Ambos proveedores son GRATIS y NO piden tarjeta de crédito.
# =====================================================================

# --- Chat / LLM: Mistral ----------------------------------------------
# API compatible con OpenAI, por eso el código usa el cliente `OpenAI`.
# Obtén tu key gratuita en: https://console.mistral.ai/api-keys
LLM_BASE_URL="https://api.mistral.ai/v1"
LLM_API_KEY=""
LLM_MODEL="mistral-small-latest"
LLM_MODEL_SMALL="ministral-8b-latest"

# --- Alternativa: Groq (rama `main`) ----------------------------------
# Para volver a Groq, comenta las 4 líneas de arriba y descomenta estas.
# Key gratuita en: https://console.groq.com/keys
# LLM_BASE_URL="https://api.groq.com/openai/v1"
# LLM_API_KEY=""
# LLM_MODEL="llama-3.3-70b-versatile"
# LLM_MODEL_SMALL="llama-3.1-8b-instant"

# Modelos de chat. Si no defines estas variables, el código usa los de Groq
# por defecto. Existen para poder cambiar de proveedor sin tocar los notebooks
# (útil si te quedas sin cuota diaria). Ver la rama `Mistral` para un ejemplo.
LLM_MODEL="llama-3.3-70b-versatile"
LLM_MODEL_SMALL="llama-3.1-8b-instant"

# --- Embeddings: Google AI Studio (Gemini) ----------------------------
# Los embeddings se mantienen en Gemini en ambas ramas.
# Mistral tiene `mistral-embed`, pero el pipeline de RAG está validado con Gemini. Basta la cuenta de Google que ya usas para Colab.
# Obtén tu key en: https://aistudio.google.com/apikey
GOOGLE_API_KEY=""

# --- Observabilidad: LangSmith (opcional, se usa en RA1/IL1.4 y RA3) --
# Obtén tu key en: https://smith.langchain.com/settings
LANGSMITH_TRACING="false"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="ingenieria-soluciones-ia"
